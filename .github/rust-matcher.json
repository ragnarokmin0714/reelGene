{
  "problemMatcher": [
    {
      "owner": "rustc",
      "pattern": [
        { "regexp": "^(warning|error)(?:\\[\\S+\\])?: (.+)$", "severity": 1, "message": 2 },
        { "regexp": "^\\s+--> (.+):(\\d+):(\\d+)$", "file": 1, "line": 2, "column": 3 }
      ]
    },
    {
      "owner": "rust-test-panic",
      "pattern": [
        { "regexp": "^thread '([^']+)'(?: \\(\\d+\\))? panicked at (.+):(\\d+):(\\d+):$", "code": 1, "file": 2, "line": 3, "column": 4 },
        { "regexp": "^(.+)$", "message": 1 }
      ]
    }
  ]
}
